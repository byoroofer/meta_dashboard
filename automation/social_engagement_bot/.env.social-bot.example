OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

BOT_KEYWORDS=cleaning service,house cleaning,deep clean,move out cleaning
BOT_REPLY_STYLE=Helpful, concise, natural, and non-pushy.
BOT_DM_CALL_TO_ACTION=If it fits naturally, invite them to DM for a quote or more details.
BOT_MAX_REPLIES_PER_HOUR=12
BOT_MAX_ITEM_AGE_MINUTES=180
BOT_MIN_TEXT_LENGTH=30
BOT_POLL_SECONDS=30
BOT_REQUIRE_QUESTION_OR_INTENT=true
BOT_ONE_SHOT=false
DRY_RUN=true
ENABLE_REDDIT=true
ENABLE_FACEBOOK=true

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=social-engagement-bot/0.1 by your_reddit_username
REDDIT_SUBREDDITS=cleaningtips,smallbusiness

FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_IDS=
FACEBOOK_GRAPH_VERSION=v20.0
