{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "destination": "/meta-dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/meta-dashboard/privacy"
    },
    {
      "source": "/api/meta/webhooks",
      "destination": "/meta-dashboard/api/meta/webhooks"
    },
    {
      "source": "/api/meta/data-deletion",
      "destination": "/meta-dashboard/api/meta/data-deletion"
    }
  ]
}
